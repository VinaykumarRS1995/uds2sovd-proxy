@startuml DoIP Server - Sequence Diagram

skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #4A7CC7
  ActorBorderColor #4A7CC7
  LifeLineBorderColor #4A7CC7
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #4A7CC7
  BoxBackgroundColor #F0F0F0
  BoxBorderColor #AAAAAA
}

participant "Tester\n(TCP Client)" as T
participant "DoipCodec\ncodec.rs" as C
participant "DoipPayload\npayload.rs" as P
participant "SessionManager\nsession.rs" as SM
participant "Session\nsession.rs" as S
participant "Handler\n(future)" as H
participant "UdsHandler\n(user impl)" as U

== Connection Setup ==

T -> C : TCP connect
C -> SM : create_session(peer_addr)
SM -> S ** : Session::new(id, addr)\nstate=Connected

== Routing Activation (ISO 13400-2 sec 7.7) ==

T -> C : bytes [0x02,0xFD,0x00,0x05,...]\nRoutingActivationRequest
C -> C : decode()\nDoipHeader::parse()\nstate to Payload
C -> H : DoipMessage { type=0x0005 }
H -> P : DoipPayload::parse(msg)
P -> P : routing_activation::Request::parse()
P --> H : DoipPayload::RoutingActivationRequest(req)

H -> SM : update_session(id, activate_routing)
SM -> S : activate_routing(0x0E80)\nstate to RoutingActive

H -> H : routing_activation::Response::success(\n  req.source_address(), config.logical_address())
H -> C : DoipCodec::encode(DoipMessage)
C --> T : bytes [0x02,0xFD,0x00,0x06,...,0x10]\nRoutingActivationResponse (Success)

== Alive Check Ping/Pong (ISO 13400-2 sec 7.6) ==

note over H : T_TCP_General_Inactivity fires\n(5 min default)
H -> H : alive_check::Request -- to_bytes() -- []
H -> C : encode(DoipMessage { type=0x0007, payload=[] })
C --> T : bytes [0x02,0xFD,0x00,0x07,0x00,0x00,0x00,0x00]

note over H : start T_TCP_Alive_Check\n(500ms timeout)

T -> C : bytes [0x02,0xFD,0x00,0x08,0x00,0x00,0x00,0x02,0x0E,0x80]
C -> H : DoipMessage { type=0x0008, payload=[0x0E,0x80] }
H -> P : DoipPayload::parse(msg)
P -> P : alive_check::Response::parse([0x0E,0x80])\nsource_address=0x0E80
P --> H : DoipPayload::AliveCheckResponse(resp)

H -> S : tester_address() -- returns 0x0E80
H -> H : resp.source_address() == 0x0E80 OK\nreset inactivity timer

== Diagnostic Message / UDS (ISO 13400-2 sec 7.9) ==

T -> C : bytes [0x02,0xFD,0x80,0x01,...]\nDiagnosticMessage (UDS: 0x22,0xF1,0x90)
C -> H : DoipMessage { type=0x8001 }
H -> P : DoipPayload::parse(msg)
P -> P : diagnostic_message::Message::parse()\nSA=0x0E80, TA=0x0091\nuser_data=[0x22,0xF1,0x90]
P --> H : DoipPayload::DiagnosticMessage(msg)

H -> S : is_routing_active() -- returns true

H -> H : DiagnosticAck::positive(TA, SA, user_data.clone())
H -> C : encode(DiagnosticMessagePositiveAck)
C --> T : [0x02,0xFD,0x80,0x02,...] DiagMsgAck

H -> U : UdsRequest::new(SA=0x0E80, TA=0x0091,\n  payload=[0x22,0xF1,0x90])
U -> U : match service_id() -- 0x22\nREAD_DATA_BY_IDENTIFIER
U --> H : UdsResponse::new(0x0091, 0x0E80, [0x62,0xF1,0x90,...])

H -> H : diagnostic_message::Message::new(\n  SA=0x0091, TA=0x0E80, user_data)
H -> C : encode(DoipMessage { type=0x8001 })
C --> T : [0x02,0xFD,0x80,0x01,...] DiagnosticMessage (UDS response)

== Disconnection ==

T ->x C : TCP close / timeout
H -> SM : remove_session(id)
SM -> S !! : Session dropped\nstate=Closed

@enduml